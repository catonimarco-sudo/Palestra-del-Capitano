rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'catonimarco@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        true
      );
    }

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 100 && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // Gym Weekly Schedule
    match /gym_schedule/{rowId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(rowId);
    }

    // Students / Allievi Collection
    match /gym_students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(studentId);
    }

    // Gym Center Settings & Category Colors
    match /gym_settings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(settingsId);
    }
  }
}
