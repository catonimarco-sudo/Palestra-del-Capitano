rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 100;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Gym Weekly Schedule (real-time shared between Vercel, AI Studio and all devices)
    match /gym_schedule/{rowId} {
      allow get, list: if true;
      allow write: if isValidId(rowId);
    }

    // Students / Allievi Collection
    match /gym_students/{studentId} {
      allow get, list: if true;
      allow write: if isValidId(studentId);
    }

    // Gym Center Settings & Category Colors
    match /gym_settings/{settingsId} {
      allow get, list: if true;
      allow write: if isValidId(settingsId);
    }
  }
}
